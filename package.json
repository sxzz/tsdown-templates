{
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint --cache",
    "format": "prettier --write .",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.7.0",
    "@sxzz/prettier-config": "^2.3.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "prettier": "@sxzz/prettier-config"
}
